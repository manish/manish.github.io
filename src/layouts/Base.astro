---
const { title, description = 'Manish Sinha — software engineer and reader.' } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} · Manish Sinha` : 'Manish Sinha';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Manish Sinha</a>
      <nav>
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a>
        <a href="/books/" aria-current={path.startsWith('/books') ? 'page' : undefined}>Books</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Manish Sinha</span>
      <span>Covers via <a href="https://openlibrary.org">Open Library</a></span>
    </footer>
  </body>
</html>

<style is:global>
  /* Magazine theme: a masthead, heavy serif headlines, sans-serif kickers. */
  :root {
    --paper: #fbfaf6;
    --ink: #121212;
    --ink-soft: #5c5b57;
    --rule: #d8d5cc;
    --accent: #d42a20;
    --shadow: rgb(0 0 0 / 0.45);
    --display: 'Playfair Display', 'Iowan Old Style', Georgia, serif;
    --body: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--body); font-size: 1rem; line-height: 1.6; }
  a { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  a:hover { color: var(--accent); }
  h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.1; text-wrap: balance; margin: 0; }
  h1 { font-size: clamp(2.4rem, 6.5vw, 5rem); font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  h1 em { font-weight: 500; color: var(--accent); }
  main { max-width: 72rem; margin: 0 auto; padding: 0 1.25rem 5rem; }

  .site-header { max-width: 72rem; margin: 0 auto; padding: 1.25rem 1.25rem 0; text-align: center; }
  .wordmark {
    display: block;
    padding-top: 1rem;
    border-top: 6px solid var(--ink);
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2rem, 7vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .wordmark:hover { color: inherit; }
  .site-header nav {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .site-header nav a { text-decoration: none; }
  .site-header nav a[aria-current='page'] { color: var(--accent); }
  .site-footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Kicker: the small red label above a headline. */
  .eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin: 0 0 1rem; }
  .tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.5em 0.7em;
    border: 1px solid var(--ink);
    white-space: nowrap;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 2.75rem 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 56rem) { .book-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 36rem) { .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; } }
</style>
