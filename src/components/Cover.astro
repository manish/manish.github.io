---
// A book cover. The painted fallback (title on a colour field) is always
// rendered; the real cover image sits on top and removes itself if it fails.
const { book, size = 'md' } = Astro.props;

let hash = 0;
for (const ch of book.title + book.author) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const hue = hash % 360;
const tilt = ((hash >> 8) % 5) - 2;
---

<div class={`cover cover-${size}`} style={`--hue:${hue}; --tilt:${tilt}deg`}>
  <div class="cover-art" aria-hidden="true">
    <span class="cover-title">{book.title}</span>
    <span class="cover-author">{book.author}</span>
  </div>
  {book.cover && (
    <img src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" decoding="async" onerror="this.remove()" />
  )}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: 3px 6px 6px 3px;
    overflow: hidden;
    background: linear-gradient(155deg, hsl(var(--hue) 42% 34%), hsl(calc(var(--hue) + 40) 48% 20%));
    box-shadow:
      inset 5px 0 0 rgb(0 0 0 / 0.18),
      inset 6px 0 0 rgb(255 255 255 / 0.12),
      0 1px 1px rgb(0 0 0 / 0.2),
      0 14px 28px -12px var(--shadow);
  }
  .cover-art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14% 12% 12% 16%;
    color: hsl(var(--hue) 60% 94%);
  }
  .cover-title {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(0.95rem, 9cqw, 2rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .cover-author {
    font-size: clamp(0.6rem, 4.2cqw, 0.85rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .cover { container-type: inline-size; }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
