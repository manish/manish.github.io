---
import Base from '../../src/layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { getBooks, findSeries, universeOf } from '../lib/data.js';

export function getStaticPaths() {
  return getBooks().map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const series = findSeries(book.series);
const universe = universeOf(book);
const tags = [...book.genres, book.length, book.fiction ? 'fiction' : 'non-fiction', ...book.themes];
---

<Base title={book.title} description={book.description || `${book.title} by ${book.author}`}>
  <p class="back"><a href="/books/">← All books</a></p>

  <article class="book">
    <div class="side">
      <Cover book={book} size="lg" />
      <div class="links">
        {book.goodreads && <a href={book.goodreads} rel="noopener">Goodreads</a>}
        {book.amazon && <a href={book.amazon} rel="noopener">Amazon</a>}
      </div>
    </div>

    <div class="body">
      <p class="eyebrow">{book.genres.join(' · ')}</p>
      <h1>{book.title}</h1>
      <p class="byline">
        {book.author}{book.year && <span> · {book.year}</span>}
      </p>

      {(series || universe) && (
        <p class="belongs">
          {series && (
            <>
              {book.seriesOrder ? `Book ${book.seriesOrder} of ` : 'Part of '}
              <a href={`/books/series/${series.slug}/`}>{series.name}</a>
            </>
          )}
          {series && universe && ' · '}
          {universe && (
            <>
              <a href={`/books/universes/${universe.slug}/`}>{universe.name}</a> universe
            </>
          )}
        </p>
      )}

      <section class="reasons">
        <h2>You should read this if you…</h2>
        <ul>
          {book.reasons.map((reason) => <li>{reason}</li>)}
        </ul>
      </section>

      {book.description && (
        <section class="take">
          <h2>My take</h2>
          <p>{book.description}</p>
        </section>
      )}

      {book.dislikes?.length > 0 && (
        <section class="dislikes">
          <h2>What I didn't like</h2>
          <ul>
            {book.dislikes.map((d) => <li>{d}</li>)}
          </ul>
        </section>
      )}

      {book.publisherDescription && (
        <section class="publisher">
          <h2>From the publisher</h2>
          <p>{book.publisherDescription}</p>
        </section>
      )}

      <div class="tags">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </article>
</Base>

<style>
  .back { margin: 1.5rem 0 2.5rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  .book { display: grid; grid-template-columns: minmax(12rem, 19rem) 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .side { position: sticky; top: 1.5rem; }
  .links { display: flex; gap: 1.5rem; margin-top: 1.25rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  .byline { font-family: var(--display); font-style: italic; font-size: 1.4rem; color: var(--ink-soft); margin: 1rem 0 0; }
  .belongs { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--ink-soft); }
  section { margin-top: 3rem; max-width: 42rem; }
  h2 { font-family: var(--body); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
  section p { margin: 0; }
  .reasons { padding-top: 1.25rem; border-top: 4px solid var(--ink); }
  .reasons h2 { font-family: var(--display); font-style: italic; font-weight: 500; font-size: 1.7rem; letter-spacing: 0; text-transform: none; color: var(--ink); }
  .reasons ul { list-style: none; padding: 0; margin: 0; counter-reset: reason; }
  .reasons li {
    counter-increment: reason;
    position: relative;
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.3;
    padding: 0.9rem 0 0.9rem 3rem;
    border-top: 1px solid var(--rule);
  }
  .reasons li::before {
    content: counter(reason, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.15rem;
    font-family: var(--body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .take p { font-size: 1.1rem; line-height: 1.7; }
  .take p::first-letter { font-family: var(--display); font-weight: 900; font-size: 3.6em; line-height: 0.8; float: left; padding: 0.08em 0.1em 0 0; }
  .dislikes ul { margin: 0; padding-left: 1.1rem; }
  .dislikes li + li { margin-top: 0.4rem; }
  .publisher p { font-family: var(--display); font-style: italic; color: var(--ink-soft); }
  .tags { margin-top: 3rem; }
  @media (max-width: 44rem) {
    .book { grid-template-columns: 1fr; gap: 2rem; }
    .side { position: static; max-width: 13rem; }
  }
</style>
